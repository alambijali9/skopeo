name: Copy Latest 5 Images

on:
  workflow_dispatch:

jobs:
  copy-images:
    runs-on: ubuntu-latest

    env:
      SRC_ACR: mysourceacr
      DEST_ACR: mydestacr
      REPOSITORY: backend

    steps:

      - name: Install Tools
        run: |
          sudo apt-get update
          sudo apt-get install -y skopeo jq

      - name: Azure Login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Login Source ACR
        run: |
          skopeo login ${SRC_ACR}.azurecr.io \
            -u ${{ secrets.SRC_ACR_USERNAME }} \
            -p ${{ secrets.SRC_ACR_PASSWORD }}

      - name: Login Destination ACR
        run: |
          skopeo login ${DEST_ACR}.azurecr.io \
            -u ${{ secrets.DEST_ACR_USERNAME }} \
            -p ${{ secrets.DEST_ACR_PASSWORD }}

      - name: Get Latest 5 Tags
        run: |

          az acr repository show-tags \
            --name $SRC_ACR \
            --repository $REPOSITORY \
            --orderby time_desc \
            --top 5 \
            --output tsv > tags.txt

          echo "Latest Tags:"
          cat tags.txt

      - name: Copy Images
        run: |

          while read tag; do

            echo "Copying: $REPOSITORY:$tag"

            skopeo copy --all \
              docker://${SRC_ACR}.azurecr.io/${REPOSITORY}:$tag \
              docker://${DEST_ACR}.azurecr.io/${REPOSITORY}:$tag

          done < tags.txt
